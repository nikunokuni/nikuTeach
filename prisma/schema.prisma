// オンライン家庭教師アプリ - データモデル
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  TEACHER
  STUDENT
  SUPPORTER
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String
  role         Role
  pointsBalance Int     @default(0) // 予約ポイント残高 (1pt = 30分)
  createdAt    DateTime @default(now())

  // teacher が作成した授業可能枠(窓)
  slotsAsTeacher    Slot[]    @relation("TeacherSlots")
  // 授業
  lessonsAsTeacher  Lesson[]  @relation("TeacherLessons")
  lessonsAsStudent  Lesson[]  @relation("StudentLessons")
  // メッセージ
  messages          Message[]
  // 成績
  grades            Grade[]
  // フィードバック
  feedbacks         Feedback[]
  // 画像更新者
  problemImages     ProblemImage[]
  // ポイント履歴
  pointTransactions PointTransaction[]
  // 先生が「この生徒」について書くメモ
  notesAboutMe      StudentNote[]   @relation("StudentNotes")
  // 先生→「この生徒」へのまとめノート
  summaryNotes      SummaryNote[]   @relation("StudentSummaryNotes")
  // 先生の授業カンペ(ライブラリ)
  cheatSheets       CheatSheet[]    @relation("TeacherCheatSheets")
  // 応援団向けに投稿した「がんばってることエピソード」
  episodes          Episode[]
  // 応援団: お気に入り登録した生徒
  favoriteStudents  Favorite[]      @relation("SupporterFavorites")
  // 生徒: 自分をお気に入り登録している応援団
  favoritedBy       Favorite[]      @relation("StudentFavoritedBy")
  // 応援団: エピソードへの「いいね」
  episodeLikes      EpisodeLike[]
  // 応援団: エピソードへのコメント
  episodeComments   EpisodeComment[]
}

// 授業可能な時間帯(窓): 先生が登録。生徒はこの窓の中の一部を予約する。
// 予約された部分は他の生徒からは埋まって見える(重複予約は不可)。
model Slot {
  id        String   @id @default(cuid())
  teacher   User     @relation("TeacherSlots", fields: [teacherId], references: [id])
  teacherId String
  startTime DateTime
  endTime   DateTime
  createdAt DateTime @default(now())

  lessons   Lesson[] // この窓の中で予約された授業(複数可)

  @@index([teacherId])
}

// 授業: 予約が確定すると生成。ビデオURLを自動生成。ポイントを消費。
model Lesson {
  id         String   @id @default(cuid())
  slot       Slot?    @relation(fields: [slotId], references: [id])
  slotId     String?
  teacher    User     @relation("TeacherLessons", fields: [teacherId], references: [id])
  teacherId  String
  student    User     @relation("StudentLessons", fields: [studentId], references: [id])
  studentId  String
  subject    String   @default("") // 科目
  startTime  DateTime
  endTime    DateTime
  pointsCost Int      @default(1) // 消費ポイント (= 長さ/30分)
  videoUrl   String
  status     String   @default("SCHEDULED") // SCHEDULED | DONE | CANCELLED
  createdAt  DateTime @default(now())

  problemImages ProblemImage[]
  feedbacks     Feedback[]

  @@index([teacherId])
  @@index([studentId])
  @@index([slotId])
}

// ポイント取引履歴: 購入(+) / 予約消費(-) / 返却(+)
model PointTransaction {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  amount    Int      // +購入/返却, -消費
  reason    String   // PURCHASE | BOOKING | REFUND
  detail    String   @default("")
  createdAt DateTime @default(now())

  @@index([userId])
}

// 問題画像: 授業ごと。先生・生徒どちらからでも追加/削除できる
model ProblemImage {
  id           String   @id @default(cuid())
  lesson       Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId     String
  data         String   // base64 data URL
  caption      String   @default("")
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  uploadedById String
  createdAt    DateTime @default(now())

  @@index([lessonId])
}

// チャット: 先生と生徒の会話 (生徒ごとのスレッド)
model Message {
  id         String   @id @default(cuid())
  studentId  String   // 会話相手の生徒 (スレッド識別)
  sender     User     @relation(fields: [senderId], references: [id])
  senderId   String
  body       String
  createdAt  DateTime @default(now())

  @@index([studentId])
}

// 授業後フィードバック: 先生・生徒双方から
model Feedback {
  id         String   @id @default(cuid())
  lesson     Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId   String
  author     User     @relation(fields: [authorId], references: [id])
  authorId   String
  authorRole String   // TEACHER | STUDENT
  body       String
  rating     Int?     // 任意の5段階評価
  createdAt  DateTime @default(now())

  @@index([lessonId])
}

// 成績: 生徒が入力、先生はいつでも閲覧
model Grade {
  id        String   @id @default(cuid())
  student   User     @relation(fields: [studentId], references: [id])
  studentId String
  type      String   // TEST(テスト点数) | NAISHIN(内申点)
  subject   String   // 教科
  score     Float    // 点数 or 内申評定
  maxScore  Float?   // テスト満点 (内申は省略可)
  examName  String   @default("") // 「中間テスト」など
  date      DateTime
  note      String   @default("")
  createdAt DateTime @default(now())

  @@index([studentId])
}

// 生徒メモ: 先生が生徒の特徴・習熟度を逐一記録。授業中でも時間外でも編集可。
model StudentNote {
  id        String   @id @default(cuid())
  student   User     @relation("StudentNotes", fields: [studentId], references: [id])
  studentId String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
}

// まとめノート: 先生が作成して生徒に投稿。生徒はいつでも閲覧。チャットとは別。
model SummaryNote {
  id        String   @id @default(cuid())
  student   User     @relation("StudentSummaryNotes", fields: [studentId], references: [id])
  studentId String
  title     String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
}

// 授業カンペ: 先生が事前に作る再利用ライブラリ。授業中に参照する。
model CheatSheet {
  id        String   @id @default(cuid())
  teacher   User     @relation("TeacherCheatSheets", fields: [teacherId], references: [id])
  teacherId String
  title     String
  subject   String   @default("")
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teacherId])
}

// がんばってることエピソード: 先生・生徒が「最近がんばってること/勉強の状況」を投稿。
// 応援団(資金援助者)はこれを見て、応援したくなる・応援してよかったと思える材料にする。
model Episode {
  id         String   @id @default(cuid())
  author     User     @relation(fields: [authorId], references: [id])
  authorId   String
  authorRole String   // TEACHER | STUDENT
  title      String
  body       String
  createdAt  DateTime @default(now())

  likes      EpisodeLike[]
  comments   EpisodeComment[]

  @@index([authorId])
}

// 応援団のお気に入り生徒: 登録すると、その生徒の投稿がフィードで優先的に表示される
model Favorite {
  id          String   @id @default(cuid())
  supporter   User     @relation("SupporterFavorites", fields: [supporterId], references: [id])
  supporterId String
  student     User     @relation("StudentFavoritedBy", fields: [studentId], references: [id])
  studentId   String
  createdAt   DateTime @default(now())

  @@unique([supporterId, studentId])
  @@index([supporterId])
  @@index([studentId])
}

// エピソードへの「いいね」: 応援団から
model EpisodeLike {
  id          String   @id @default(cuid())
  episode     Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  episodeId   String
  supporter   User     @relation(fields: [supporterId], references: [id])
  supporterId String
  createdAt   DateTime @default(now())

  @@unique([episodeId, supporterId])
  @@index([episodeId])
}

// エピソードへのコメント: 応援団から
model EpisodeComment {
  id        String   @id @default(cuid())
  episode   Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  episodeId String
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  body      String
  createdAt DateTime @default(now())

  @@index([episodeId])
}
